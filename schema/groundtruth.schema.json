{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroundTruth",
  "type": "object",
  "required": ["package", "language", "ecosystem", "findings", "sca"],
  "additionalProperties": false,
  "properties": {
    "package": {"type": "string"},
    "language": {"enum": ["python", "java", "go", "rust", "ruby", "csharp"]},
    "ecosystem": {"enum": ["pypi", "maven", "go", "cargo", "rubygems", "nuget"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "line", "cwe", "class", "severity", "exploitability"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
          "class": {"type": "string"},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "exploitability": {"enum": ["true-positive", "mitigated-by-design", "false-positive"]},
          "notes": {"type": "string"}
        }
      }
    },
    "sca": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "ecosystem"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"},
          "cve": {"type": "string"},
          "ecosystem": {"enum": ["pypi", "maven", "go", "cargo", "rubygems", "nuget"]},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]}
        }
      }
    }
  }
}
